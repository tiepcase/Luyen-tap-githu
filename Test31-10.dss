! =========================================================================
! 6. GI?I BÀI TOÁN 24 GI? VÀ V? Ð? TH? (ÐÃ FIX L?I ÐU?NG D?N TI?NG VI?T)
! =========================================================================
! Chuy?n thu m?c xu?t d? li?u d? th? sang ? D:\DSS_Out (nh? t?o thu m?c D:\DSS_Out tru?c)
Set Datapath=D:\DSS_Out

! Khai báo các Monitor theo dõi 24h TRU?C khi Solve
New Monitor.Mon_Sub_PQ Element=Line.L1  Terminal=1 Mode=1 ppolar=no
New Monitor.Mon_V18    Element=Line.L17 Terminal=2 Mode=0
New Monitor.Mon_EV2    Element=Load.EVCS_2 Terminal=1 Mode=1 ppolar=no

Set VoltageBases=[12.66]
CalcVoltageBases

! Gi?i chu?i 24 gi?
Set mode=daily stepsize=1h number=24
Solve

! 1. Xem báo cáo t?n th?t 24h và Ði?n áp 33 nút
Show Meters
Show Voltage LN Nodes

! 2. V? d? th? biên d?ng s?t áp d?c 33 nút (Voltage Profile)
Plot Profile Phases=All

! 3. V? d? th? công su?t tr?m bi?n áp và tr?m s?c EVCS_2 trong 24h
Plot Monitor Object=Mon_Sub_PQ Channels=(1 2)
Plot Monitor Object=Mon_EV2    Channels=(1)
Plot Monitor Object=Mon_V18    Channels=(1 3 5)

